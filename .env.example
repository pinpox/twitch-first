TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_CHANNEL=your_channel_name
# Optional: filter to a specific reward by ID (leave empty to match any)
TWITCH_REWARD_ID=
# Optional: database path (default: firsts.db)
TWITCH_FIRST_DB=firsts.db
# Optional: bot display name (default: same as channel)
TWITCH_BOT_NAME=
# Optional: token file path (default: token.json)
TWITCH_TOKEN_FILE=token.json
